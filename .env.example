# ============================================================================
# MANSCO Spare Parts Portal — environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# Public anon key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET service-role key — SERVER-SIDE ONLY. Never expose to the browser and
# never import src/lib/supabase/admin.ts into a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (Prisma — schema source of truth / drift checks) ────────────────
# Pooled connection (app) and direct connection (migrations / drift).
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL_UNPOOLED=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=MANSCO Spare Parts Portal
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── SAP CSV Sync (defaults) ─────────────────────────────────────────────────
SAP_SYNC_CRON=*/30 * * * *
SAP_SYNC_STALE_THRESHOLD_MINUTES=60

# ── Rate limiting (audit item 6 — not yet enforced) ─────────────────────────
# Provision Upstash Redis via the Vercel Marketplace, then wire
# src/lib/rate-limit.ts to these values.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Carrier tracking (future — fulfillment Module 6) ────────────────────────
# DHL_API_KEY=
